Options -MultiViews -Indexes
DirectoryIndex index.html
AddDefaultCharset UTF-8

# ---------------------------------------------------------------------------
# Rutas
# ---------------------------------------------------------------------------
RewriteEngine On

# HTTPS obligatorio: descomentar cuando el certificado SSL esté activo en HostGator
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# /servicios se unió con /generate-service (redirección permanente para enlaces antiguos)
RewriteRule ^servicios/?$ /generate-service/ [R=301,L]

# La portada vive en /home/: el servidor redirige la raíz antes de cargar la página
# (así Analytics registra una sola vista y no carga la página intermedia de Next.js)
RewriteRule ^$ /home/ [R=301,L]

# Archivos y carpetas exportados se sirven tal cual (cada página es carpeta/index.html)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Compatibilidad con exportaciones sin barra final (ruta.html)
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

ErrorDocument 404 /404.html

# ---------------------------------------------------------------------------
# Tipos de archivo
# ---------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType video/mp4 .mp4
  AddType video/webm .webm
  AddType image/svg+xml .svg
  AddType application/manifest+json .webmanifest
</IfModule>

# ---------------------------------------------------------------------------
# Compresión (HTML, CSS, JS, JSON, SVG)
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json image/svg+xml
</IfModule>

# ---------------------------------------------------------------------------
# Caché del navegador
# ---------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType video/mp4 "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
  # Los archivos de _next/static llevan un hash en el nombre: se pueden guardar para siempre
  <If "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>

  # Cabeceras de seguridad básicas
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
