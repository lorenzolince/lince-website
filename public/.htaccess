Options -MultiViews
DirectoryIndex index.html

RewriteEngine On

# Serve exported files and directories without rewriting them.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Map clean public routes to the HTML files generated by Next.js.
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
